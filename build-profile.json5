{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "quec_privacy_policy",
      "srcPath": "./quec_privacy_policy/quec_privacy_policy",
    },
    {
      "name": "quec_privacy_policy_api",
      "srcPath": "./quec_privacy_policy/quec_privacy_policy_api",
    },
    {
      "name": "quec_main",
      "srcPath": "./quec_main/quec_main",
    },
    {
      "name": "quec_main_api",
      "srcPath": "./quec_main/quec_main_api",
    },
    {
      "name": "quec_ui_config",
      "srcPath": "./quec_ui_config",
    },
    {
      "name": "quec_basic_ui",
      "srcPath": "./quec_basic_ui",
    },
    {
      "name": "quec_network",
      "srcPath": "./quec_network",
    },
    {
      "name": "quec_mmkv",
      "srcPath": "./quec_mmkv",
    },
    {
      "name": "quec_login",
      "srcPath": "./quec_login/quec_login",
    },
    {
      "name": "quec_login_api",
      "srcPath": "./quec_login/quec_login_api",
    },
    {
      "name": "quec_foundation",
      "srcPath": "./quec_foundation",
    },
    {
      "name": "quec_encrypt",
      "srcPath": "./quec_encrypt",
    },
    {
      "name": "quec_user_sdk",
      "srcPath": "./quec_user_sdk",
    }
  ]
}
